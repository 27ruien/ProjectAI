NODE_ENV=development
PORT=3000
NEXT_PUBLIC_BASE_PATH=/tool/projectai
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_COMMIT_SHA=local
NEXT_PUBLIC_BUILD_TIME=local

DATABASE_URL=postgresql://projectai:replace-me@127.0.0.1:5432/projectai_slim
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000/tool/projectai/api/auth
AUTH_COOKIE_PREFIX=projectai_local
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000
AUTH_PROVIDER=wecom
ALLOW_MOCK_WECOM_AUTH=false
ALLOW_STAGING_TEST_LOGIN=false
ALLOW_LEGACY_CREDENTIAL_TEST_AUTH=false
ALLOW_STAGING_CREDENTIAL_AUTH=false
ORGANIZATION_NAME=Kivisense

WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_AUTH_CALLBACK_URL=
WECOM_AUTH_SECRET_FILE=

AI_ASSISTANT_ENABLED=false
AI_PROVIDER=qwen
AI_REGION=cn-beijing
AI_PROJECT_ASSISTANT_PROFILE_ID=qwen-project-assistant-cn-v2
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_API_KEY_FILE=
AI_PROVIDER_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=1800

RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
RAGFLOW_API_KEY_FILE=
RAGFLOW_REQUEST_TIMEOUT_MS=30000
RAGFLOW_RETRIEVAL_TOP_K=64
RAGFLOW_RETRIEVAL_THRESHOLD=0.2
KNOWLEDGE_PER_PROJECT_EVIDENCE_LIMIT=3
KNOWLEDGE_GLOBAL_EVIDENCE_LIMIT=12
KNOWLEDGE_MAX_CONTEXT_CHARS=24000
KNOWLEDGE_CROSS_PROJECT_CONCURRENCY=3

# Read only by `knowledge:migrate-ragflow`; not part of the Slim runtime.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_USE_SSL=true
