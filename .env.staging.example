NODE_ENV=production
PORT=3000
NEXT_PUBLIC_BASE_PATH=/tool/projectai-staging
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_VERSION=1.0.0-staging
NEXT_PUBLIC_COMMIT_SHA=
NEXT_PUBLIC_BUILD_TIME=

DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://gridworks.cn/tool/projectai-staging/api/auth
AUTH_COOKIE_PREFIX=projectai_staging
AUTH_TRUSTED_ORIGINS=https://gridworks.cn
AUTH_PROVIDER=staging-credential
ALLOW_MOCK_WECOM_AUTH=false
ALLOW_STAGING_TEST_LOGIN=false
ALLOW_STAGING_CREDENTIAL_AUTH=true
ORGANIZATION_NAME=Kivisense

AI_ASSISTANT_ENABLED=true
AI_PROVIDER=qwen
AI_REGION=cn-beijing
AI_PROJECT_ASSISTANT_PROFILE_ID=qwen-project-assistant-cn-v2
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY_FILE=/run/secrets/qwen_api_key
AI_PROVIDER_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=1800

RAGFLOW_BASE_URL=http://host.docker.internal:19380
RAGFLOW_API_KEY_FILE=/run/secrets/ragflow_api_key
RAGFLOW_REQUEST_TIMEOUT_MS=30000
RAGFLOW_RETRIEVAL_TOP_K=64
RAGFLOW_RETRIEVAL_THRESHOLD=0.2
KNOWLEDGE_PER_PROJECT_EVIDENCE_LIMIT=3
KNOWLEDGE_GLOBAL_EVIDENCE_LIMIT=12
KNOWLEDGE_MAX_CONTEXT_CHARS=24000
KNOWLEDGE_CROSS_PROJECT_CONCURRENCY=3

# Host-only Compose inputs; do not commit their values.
POSTGRES_PASSWORD_FILE_HOST=
QWEN_API_KEY_FILE_HOST=
RAGFLOW_API_KEY_FILE_HOST=
PROJECTAI_LOOPBACK_PORT=3101
