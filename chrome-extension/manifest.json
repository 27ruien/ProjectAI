{
  "manifest_version": 3,
  "name": "Project AI 助手",
  "version": "0.1.2",
  "description": "从 Project AI 同步 Skill，并注入 ChatGPT、DeepSeek 和 Qwen 对话，支持 UAT 结果采集与导出。",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*"
  ],
  "action": {
    "default_title": "Project AI 助手",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "src/content/adapter-core.js",
        "src/content/chatgpt-adapter.js",
        "src/content/deepseek-adapter.js",
        "src/content/qwen-adapter.js",
        "src/content/content-script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gridworks.cn/tool/projectai-slim-uat/*"],
      "js": [
        "src/shared/project-ai-source.js",
        "src/content/project-ai-content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
